{
  "$schema": "./registry.schema.json",
  "schemaVersion": "2.0.0",
  "registryType": "tools",
  "tools": [
    {
      "id": "sales_intake_bridge",
      "agentId": "sales_intake_agent",
      "handler": "departments/marketing/sales-intake/src/SalesIntakeBridge.js",
      "actions": ["create_lead", "intake_capture"],
      "defaultInstall": true
    },
    {
      "id": "onboarding_comms_bridge",
      "agentId": "onboarding_comms_agent",
      "handler": "departments/marketing/onboarding-comms/src/OnboardingCommsBridge.js",
      "actions": [
        "email_welcome",
        "email_score_invite",
        "email_upload_reminder",
        "email_review_call",
        "email_scan_complete",
        "email_mail_reminder",
        "email_bureau_checkin",
        "email_sweep_upgrade",
        "email_testimonial",
        "email_sequence_queue"
      ],
      "defaultInstall": true
    },
    {
      "id": "dispute_agent_bridge",
      "agentId": "dispute_agent",
      "handler": "examples/dispute-agent/src/DisputeAgentBridge.js",
      "actions": [
        "intake_parsing",
        "pdf_parse",
        "dispute_generate",
        "dispute_parse_response",
        "dispute_strategy",
        "letter_package",
        "email_sequence",
        "agent_loop_trigger",
        "crm_action"
      ],
      "defaultInstall": false
    }
  ]
}
