{
  "$schema": "./registry.schema.json",
  "registryType": "agents",
  "registry": {
    "version": "1.1.0",
    "owner": null,
    "org": null,
    "canonical_lead_agent": "ceo_agent",
    "description": "Canonical agent registry for this CEO Agent install. The CEO Agent serves as the Chief Intelligence & Orchestration Agent, supervising a standard C-suite structure (CFO, COO, CTO, CMO, CHRO, CLO), each of whom supervises their own department's agents."
  },
  "orchestration": {
    "lead_agent": "ceo_agent",
    "layer": "CEO Agent workspace",
    "status": "active",
    "role": "Routes tasks, maintains memory, enforces quality, coordinates C-suite agents, and escalates human-critical decisions to the configured Principal.",
    "workspace": "ceo-agent",
    "routing_logic": {
      "executive_orchestration": "ceo_agent",
      "finance": "cfo_agent",
      "operations": "hermes",
      "technology": "cto_agent",
      "marketing": "cmo_agent",
      "people": "chro_agent",
      "legal": "clo_agent",
      "workflow_execution": "hermes",
      "lead_capture": "sales_intake_agent",
      "onboarding_comms": "onboarding_comms_agent"
    }
  },
  "agents": [
    {
      "id": "ceo_agent",
      "name": "CEO Agent",
      "status": "active",
      "version": "1.1.0",
      "title": "Chief Intelligence & Orchestration Agent",
      "role": "chief_intelligence_officer",
      "tagline": "The executive intelligence layer of your business.",
      "runtime": "configured per install",
      "lane": "executive",
      "department": "executive",
      "reports_to": null,
      "supervises": [
        "cfo_agent",
        "hermes",
        "cto_agent",
        "cmo_agent",
        "chro_agent",
        "clo_agent"
      ],
      "identity_files": [
        "IDENTITY.md",
        "BEHAVIOR.md",
        "TASK_ROUTER.md",
        "ORGANIZATION-STRUCTURE.md"
      ],
      "capabilities": [
        "task_routing",
        "agent_supervision",
        "project_memory",
        "business_strategy",
        "research_synthesis",
        "quality_control",
        "brand_enforcement",
        "revenue_prioritization",
        "escalation_management",
        "agent_registry_management"
      ],
      "authorized_projects": "Configured per install via CEO_AGENT_PROJECTS env var.",
      "off_limits": [
        "Live financial transactions",
        "Unauthorized production deployments",
        "Changing secrets or credentials",
        "Making legal guarantees",
        "Making financial promises"
      ]
    },
    {
      "id": "cfo_agent",
      "name": "CFO Agent",
      "status": "active",
      "title": "Chief Financial Officer",
      "role": "chief_financial_officer",
      "lane": "finance",
      "department": "finance",
      "reports_to": "ceo_agent",
      "supervises": [],
      "capabilities": [
        "financial_strategy",
        "financial_forecasting"
      ],
      "authorized_projects": "Configured per install via CEO_AGENT_PROJECTS env var.",
      "off_limits": [
        "Live financial transactions without approval",
        "Overriding the CEO Agent"
      ]
    },
    {
      "id": "cto_agent",
      "name": "CTO Agent",
      "status": "active",
      "title": "Chief Technology Officer",
      "role": "chief_technology_officer",
      "lane": "technology",
      "department": "technology",
      "reports_to": "ceo_agent",
      "supervises": [],
      "capabilities": [
        "technology_strategy",
        "software_development"
      ],
      "authorized_projects": "Configured per install via CEO_AGENT_PROJECTS env var.",
      "off_limits": [
        "Unauthorized production deployments",
        "Overriding the CEO Agent"
      ]
    },
    {
      "id": "cmo_agent",
      "name": "CMO Agent",
      "status": "active",
      "title": "Chief Marketing Officer",
      "role": "chief_marketing_officer",
      "lane": "marketing",
      "department": "marketing",
      "reports_to": "ceo_agent",
      "supervises": [
        "sales_intake_agent",
        "onboarding_comms_agent"
