      "folder": "departments/operations/hermes",
      "bridge": "departments/operations/hermes/src/HermesBridge.js",
      "runtime_location_env": "HERMES_RUNTIME_PATH",
      "application_location_env": "HERMES_APPLICATION_PATH",
      "external_project": "https://github.com/NousResearch/hermes-agent",
      "capabilities": [
        "operations_strategy",
        "cron_create",
        "webhook_subscribe",
        "api_trigger",
        "workflow_execution",
        "skill_chain",
        "sandbox_execution",
