      "outputSchema": { "assessment": { "type": "object", "required": true } },
      "permissions": { "requiresAgentAssignment": true },
      "handler": "core/skills/managerSkills.js#registerManagerSkills",
      "risk": "safe"
    },
    {
      "id": "department_capability_lookup",
      "capability": "management_org_lookup",
      "inputSchema": { "query": { "type": "string", "required": true } },
