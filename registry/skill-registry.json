      "outputSchema": {
        "allocations": { "type": "array", "required": true },
        "totalAllocated": { "type": "number", "required": true },
        "unusedTokens": { "type": "number", "required": true }
      },
      "permissions": { "requiresAgentAssignment": true },
      "handler": "core/skills/managerSkills.js#registerManagerSkills",
      "risk": "safe"
