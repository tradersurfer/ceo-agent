      "handler": "core/skills/exampleSkills.js#registerExampleSkills",
      "risk": "safe"
    },
    {
      "id": "format_currency",
      "capability": "currency_formatting",
      "inputSchema": {
        "amount": { "type": "number", "required": true },
        "currency": { "type": "string", "required": false }
      },
      "handler": "core/skills/exampleSkills.js#registerExampleSkills",
      "risk": "safe"
    },
    {
