      "permissions": { "requiresAgentAssignment": true },
      "handler": "core/skills/managerSkills.js#registerManagerSkills",
      "risk": "safe"
    },
    {
      "id": "quality_review",
      "capability": "management_quality",
      "inputSchema": {
        "artifact": { "type": "string", "required": true },
        "criteria": { "type": "array", "required": true },
        "passThreshold": { "type": "number", "required": false }
