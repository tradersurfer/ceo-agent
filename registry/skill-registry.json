      "outputSchema": { "review": { "type": "object", "required": true } },
      "permissions": { "requiresAgentAssignment": true },
      "handler": "core/skills/managerSkills.js#registerManagerSkills",
      "risk": "safe"
    },
    {
      "id": "budget_token_allocation",
      "capability": "management_budgeting",
      "inputSchema": {
        "totalTokens": { "type": "number", "required": true },
        "workItems": { "type": "array", "required": true }
