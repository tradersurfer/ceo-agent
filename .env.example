# Copy this file to .env and fill in the values you need. Nothing here is
# required to boot the setup wizard (npm run setup) -- it's only needed once
# you connect real model providers or wire real agent bridges. .env is
# gitignored; never commit real values.

# --- Model providers ---------------------------------------------------
# At least one is required for the runtime to make real model calls.
# OpenRouter is the default/primary path; the others are BYNGE's direct
# per-provider connections (sdk/OpenRouterClient.js, sdk/AnthropicClient.js,
# etc.), each optional.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Dispatch API (app/api/dispatch) ------------------------------------
# Required header value for POST /api/dispatch (x-dispatch-secret).
DISPATCH_SECRET=

# --- Bridge allowlists (sdk/BaseBridge.js via SalesIntakeBridge/
# OnboardingCommsBridge/HermesBridge/DisputeAgentBridge) ------------------
# Comma-separated. Empty/unset means locked-down by default -- no task
# type or approver is allowed until you explicitly list one.
CEO_AGENT_APPROVERS=
CEO_AGENT_PROJECTS=
CEO_AGENT_DEFAULT_PROJECT=

# --- Hermes (COO / Ops bridge) -------------------------------------------
# Real gateway connection (ADR-009). Both required to actually submit tasks;
# without them, HermesBridge.runTask() validates and returns 'queued'.
HERMES_GATEWAY_URL=
HERMES_GATEWAY_API_KEY=
# Optional tuning, all have sane defaults (departments-subagents/operations/
# hermes/src/HermesGatewayClient.js) -- only set these if you need to.
# HERMES_REQUEST_TIMEOUT_MS=10000
# HERMES_MAX_RETRY_ATTEMPTS=3
# HERMES_RUN_TIMEOUT_MS=900000
# HERMES_APPROVAL_TIMEOUT_MS=1800000
# HERMES_POLL_INTERVAL_MS=3000
# HERMES_MAX_CONSECUTIVE_POLL_FAILURES=3
# Legacy subprocess-model fields (ADR-001), not renamed/removed by ADR-009
# per that ADR's own scope -- unused by the current gateway-client path.
HERMES_RUNTIME_PATH=
HERMES_APPLICATION_PATH=

# --- Marketing bridges ----------------------------------------------------
SALES_INTAKE_AGENT_URL=
SALES_INTAKE_AGENT_SECRET=
ONBOARDING_COMMS_AGENT_URL=
ONBOARDING_COMMS_AGENT_SECRET=

# --- Dispute Agent (examples/dispute-agent, optional, not in the default
# roster) -------------------------------------------------------------------
DISPUTE_AGENT_URL=
DISPUTE_AGENT_WEBHOOK_SECRET=

# --- Stripe webhook verification (app/api/webhooks/stripe) ----------------
# Required for that route to accept anything; unset means it fails closed
# with 503 on every request (lib/stripeWebhookVerify.js).
STRIPE_WEBHOOK_SECRET=

# --- Persistence (Supabase-backed workflow/audit/rate-limit storage) ------
# Both required together, or omit both to fall back to in-memory storage
# (single-instance only -- see SECURITY.md).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
